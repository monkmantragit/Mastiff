# Directus (CMS). Server-only: never prefix the token with NEXT_PUBLIC_, which would
# publish it in the browser bundle.
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=your-directus-token-here

# Still read for backwards compatibility (images config / older deploys). Same value as DIRECTUS_URL.
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055

# SMTP (lead notification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=White Massif <noreply@whitemassif.com>
ADMIN_EMAIL=sales@whitemassif.com

# Microsoft Clarity project ID (optional; Clarity is skipped when unset)
NEXT_PUBLIC_CLARITY_ID=
